# Normalize line endings in the repository to LF.
# Without this, files checked out on Windows get CRLF and `gofmt -l` reports
# the whole tree as unformatted.
* text=auto eol=lf

*.go   text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.mod  text eol=lf
*.sum  text eol=lf
LICENSE text eol=lf
.env.example text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf

# Binary assets (if any are added later).
*.png  binary
*.jpg  binary
*.svg  binary
